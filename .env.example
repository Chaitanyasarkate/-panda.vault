# ==========================================
# VaultX Environment Configuration Example
# ==========================================

# Backend & Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vaultx
POSTGRES_PASSWORD=vaultx_password
POSTGRES_DB=vaultx_db
DATABASE_URL=postgresql+asyncpg://vaultx:vaultx_password@localhost:5432/vaultx_db

# Security & JWT
JWT_SECRET=super-secret-jwt-key-change-in-production-vaultx-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
